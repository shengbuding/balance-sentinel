<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置 — 明文禁令 + 证书固定的说明

  ⚠️ 证书固定（pin-set）已从这里移除，改由代码层实施，原因见下。

  历史上的做法是在 domain-config 里声明 <pin-set> 钉住 api.deepseek.com。
  平台实施的是**编译期常量**，App 里没有任何 API 能在运行时关掉它。结果是：
  用户开了 VPN / 抓包代理、证书链被替换时，即使设置页关掉了「强制 HTTPS」，
  平台仍然拒绝握手 —— 开关形同虚设，表现为「关了还是 Network request failed」。

  现在固定策略由 OkHttp 的 CertificatePinner 承担（DeepSeekTlsPolicy），
  默认开启，设置页关掉后立即不再安装 pinner，无需重启。
  pin 覆盖了全部三条访问 api.deepseek.com 的路径：
    - DeepSeekProvider.clientCache
    - DeepSeekApiService.clientCache
    - BalanceQueryService.callFactoryFor 的 DEEPSEEK 分支

  这里保留的是与固定无关、且不该被关掉的那一层：全局禁止明文 HTTP。
-->
<network-security-config>
    <!-- 所有域名的 HTTPS 流量：不在此处固定证书，但要求加密，且只信任系统 CA。 -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
